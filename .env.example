# Server (server/index.js, server/embed-dishes.js)
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash, whose free-tier allowance is only 20
# requests per day. Quotas are per model, so pointing development at a
# different one avoids burning the budget the app needs.
GEMINI_MODEL=
SUPABASE_URL=https://your-project.supabase.co
# Service key, not the publishable one — the server is the only writer to the
# shared restaurant nutrition database.
SUPABASE_SERVICE_KEY=

# Frontend. Defaults to http://localhost:3001 when unset.
VITE_API_URL=
